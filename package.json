{
  "name": "@vitortrack777/detro",
  "version": "0.1.7",
  "description": "detro CLI: CLI de desenvolvimento com IA que gera CRUDs completos (banco, API e tela) e corrige código com Ollama, revisado pelo Claude Code. NestJS, React, TypeScript e PostgreSQL.",
  "type": "module",
  "bin": {
    "detro": "./index.js"
  },
  "scripts": {
    "start": "node index.js",
    "setup": "bash ./detro.sh install",
    "update": "bash ./detro.sh update",
    "uninstall-cli": "bash ./detro.sh uninstall"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.8.0",
    "chalk": "^5.4.1"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.js",
    "ai/",
    "detro.sh",
    "detro-completion.bash",
    "LICENSE"
  ],
  "keywords": [
    "detro",
    "detro-cli",
    "cli",
    "ai",
    "ia",
    "llm",
    "ollama",
    "claude",
    "claude-code",
    "codegen",
    "code-generator",
    "crud-generator",
    "gerador-de-crud",
    "gerador-de-codigo",
    "scaffolding",
    "nestjs",
    "react",
    "typescript",
    "postgresql"
  ],
  "author": "vitortrack",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitortrack/detro-cli.git"
  },
  "homepage": "https://github.com/vitortrack/detro-cli#readme",
  "bugs": {
    "url": "https://github.com/vitortrack/detro-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
